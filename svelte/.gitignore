# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Test and verification artefacts
#
# `npm run test:landing` and `npm run test:e2e` both drive headless Chrome via
# puppeteer-core, which drops anything it decides to cache or profile into the
# working directory. The screenshots are manual: they are what a change is
# checked against, not an input to it.
.screenshots/
*.screenshot.png
.puppeteer/
.cache/puppeteer/

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
